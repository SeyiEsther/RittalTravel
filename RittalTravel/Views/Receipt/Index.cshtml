@model List<RittalTravel.Models.Receipt>
@{
    ViewData["Title"] = "Receipts & Invoices";
    string search = ViewBag.Search ?? "";
}

<div class="rt-page-header rt-flex-between">
    <div>
        <h1 class="rt-page-title">Receipts &amp; Invoices</h1>
        <p class="rt-page-sub">Upload and search travel documents</p>
    </div>
    <button type="button" class="rt-btn rt-btn-red" onclick="document.getElementById('upload-panel').classList.toggle('rl-hidden')">
        + Upload Document
    </button>
</div>

@if (TempData["Success"] != null) { <div class="rt-alert rt-alert-success">@TempData["Success"]</div> }
@if (TempData["Error"]   != null) { <div class="rt-alert rt-alert-error">@TempData["Error"]</div> }

<!-- Upload Panel -->
<div id="upload-panel" class="rt-card rl-mb rl-hidden">
    <h2 class="rt-card-title" style="margin-bottom:1rem">Upload Document</h2>
    <form asp-action="Upload" asp-controller="Receipt" method="post" enctype="multipart/form-data"
          id="rl-upload-form" onsubmit="return rlOnSubmit()">
        @Html.AntiForgeryToken()
        <div class="rl-upload-row">

            <div class="rl-upload-field">
                <div class="rl-field-label">File (PDF, JPG, PNG) <span class="rl-req">*</span></div>
                <label class="rt-btn rt-btn-outline rl-file-btn" for="rl-file-input">Choose file</label>
                <input type="file" id="rl-file-input" name="file" accept=".pdf,.jpg,.jpeg,.png,.PDF,.JPG,.JPEG,.PNG"
                       required onchange="rlFileChosen(this)" />
                <span id="rl-file-name" class="rl-file-label">No file chosen</span>
            </div>

            <div class="rl-upload-field rl-upload-field--narrow">
                <div class="rl-field-label">Document type</div>
                <select id="rl-doc-type" name="documentType" class="rl-select">
                    <option value="">— Select —</option>
                    <option value="Receipt">Receipt</option>
                    <option value="Invoice">Invoice</option>
                    <option value="Ticket">Ticket / E-ticket</option>
                    <option value="Booking">Booking confirmation</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <div class="rl-upload-field rl-upload-field--grow">
                <div class="rl-field-label">Notes <span class="rl-optional">(optional)</span></div>
                <input type="text" id="rl-notes" name="notes" class="rl-input" placeholder="e.g. Q2 client visit" />
            </div>

            <div class="rl-upload-field rl-upload-field--action">
                <button type="submit" class="rt-btn rt-btn-red" id="rl-upload-btn">Upload</button>
            </div>
        </div>
        <div id="rl-upload-status" class="rl-upload-status" aria-live="polite"></div>
    </form>
</div>

<!-- Search -->
<div class="rt-card rl-mb">
    <form method="get" class="rl-search-form">
        <input type="text" name="search" value="@search" class="rl-input"
               placeholder="Search by name, route, mode, type or filename…" />
        <button type="submit" class="rt-btn rt-btn-outline">Search</button>
        @if (!string.IsNullOrEmpty(search)) {
            <a asp-action="Index" class="rt-link rl-clear-link">Clear</a>
        }
    </form>
</div>

<!-- Results -->
<div class="rt-card">
@if (Model.Any()) {
    <div class="rt-table-wrap">
        <table class="rt-table">
            <thead><tr>
                <th>Uploaded</th>
                <th>Type</th>
                <th>File</th>
                <th>Traveller</th>
                <th>Route</th>
                <th>Trip Date</th>
                <th>Mode</th>
                <th>Notes</th>
                <th>Actions</th>
            </tr></thead>
            <tbody>
            @foreach (var r in Model) {
                <tr>
                    <td class="rt-mono rt-nowrap">@r.UploadedAt.ToString("dd MMM yyyy")</td>
                    <td>
                        @if (r.DocumentType != null) {
                            <span class="rl-type-badge rl-type-@r.DocumentType.ToLower()">@r.DocumentType</span>
                        } else {
                            <span class="rl-muted">—</span>
                        }
                    </td>
                    <td class="rt-small">
                        <a asp-action="Download" asp-route-id="@r.Id" class="rt-link" title="Download">
                            &#128196; @r.OriginalFileName
                        </a>
                    </td>
                    <td>@(r.TravellerName ?? "—")</td>
                    <td class="rt-nowrap">
                        @if (r.Origin != null || r.Destination != null) {
                            @(r.Origin ?? "—") <span>&rarr;</span> @(r.Destination ?? "—")
                        } else {
                            <span class="rl-muted">—</span>
                        }
                    </td>
                    <td class="rt-mono">@(r.TripDate ?? "—")</td>
                    <td>
                        @if (r.TransportMode != null) {
                            <span class="rt-mode-badge rt-mode-@r.TransportMode.ToLower().Replace("-","").Replace(" ","")">@r.TransportMode</span>
                        } else {
                            <span class="rl-muted">—</span>
                        }
                    </td>
                    <td class="rt-small rl-muted">@(r.Notes ?? "")</td>
                    <td>
                        <div class="rl-actions">
                            <a asp-action="Download" asp-route-id="@r.Id"
                               class="rt-btn rt-btn-sm rt-btn-outline">Download</a>
                            <form asp-action="Delete" asp-route-id="@r.Id" method="post"
                                  onsubmit="return confirm('Delete @Html.Raw(r.OriginalFileName.Replace("'","\\'"))? This cannot be undone.')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="rt-btn rt-btn-danger rt-btn-sm">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="rl-result-count">
        @Model.Count document@(Model.Count == 1 ? "" : "s")@(string.IsNullOrEmpty(search) ? "" : $" matching \"{search}\"")
    </div>
} else {
    <div class="rt-empty-state">
        @if (string.IsNullOrEmpty(search)) {
            <p>No documents uploaded yet.</p>
            <button type="button" class="rt-btn rt-btn-red"
                    onclick="document.getElementById('upload-panel').classList.remove('rl-hidden');document.getElementById('rl-file-input').click()">
                Upload Your First Document
            </button>
        } else {
            <p>No documents found matching "@search".</p>
            <a asp-action="Index" class="rt-btn rt-btn-outline">Clear search</a>
        }
    </div>
}
</div>

@section Scripts {
<style>
.rl-hidden  { display: none !important; }
.rl-mb      { margin-bottom: 1rem; }
.rl-muted   { color: var(--txm); }
.rl-req     { color: #f85149; }
.rl-optional { opacity: .55; }
.rl-file-label { font-size:.8125rem; color:var(--txm); margin-left:.6rem; }
.rl-field-label { font-size:.8125rem; color:var(--txm); margin-bottom:.35rem; }
.rl-upload-row {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    flex-wrap: wrap;
}
.rl-upload-field { flex: 0 0 auto; }
.rl-upload-field--narrow { flex: 0 0 150px; min-width: 130px; }
.rl-upload-field--grow { flex: 2; min-width: 200px; }
.rl-upload-field--action { align-self: flex-end; }
.rl-upload-status { margin-top: .75rem; font-size: .8125rem; color: var(--txm); }
.rl-search-form { display: flex; gap: .75rem; align-items: center; flex-wrap: wrap; }
.rl-search-form .rl-input { flex: 1; min-width: 220px; }
.rl-clear-link { font-size: .8125rem; }
.rl-actions { display: flex; gap: .5rem; align-items: center; }
.rl-result-count { font-size: .75rem; color: var(--txm); padding: .75rem 0 .25rem; }
.rl-input, .rl-select {
    background: var(--bg3);
    border: 1px solid var(--bd);
    border-radius: 8px;
    color: var(--tx);
    padding: .55rem .75rem;
    font-size: .875rem;
    width: 100%;
    font-family: inherit;
}
.rl-input:focus, .rl-select:focus {
    outline: none;
    border-color: var(--sc);
    box-shadow: 0 0 0 2px rgba(92,122,90,.35);
}
.rl-file-btn { cursor: pointer; display: inline-block; }
#rl-file-input { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0; }
.rt-btn-outline {
    background: transparent;
    border: 1px solid var(--bd);
    color: var(--tx);
    border-radius: 8px;
    padding: .55rem .9rem;
    font-size: .8125rem;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
}
.rt-btn-outline:hover { border-color: var(--sc); color: var(--sc); }
.rl-type-badge {
    display: inline-block;
    font-size: .6875rem;
    font-weight: 600;
    letter-spacing: .4px;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 4px;
    background: var(--bg3);
    color: var(--txm);
    border: 1px solid var(--bd);
}
.rl-type-badge.rl-type-invoice  { background:#1a2e1a; color:#4caf50; border-color:#2e5c2e; }
.rl-type-badge.rl-type-receipt  { background:#1a2430; color:#64b0e0; border-color:#1e4060; }
.rl-type-badge.rl-type-ticket   { background:#2a1f0a; color:#e0a040; border-color:#5c4010; }
.rl-type-badge.rl-type-booking  { background:#1e1430; color:#b07de0; border-color:#3c2860; }
</style>
<script>
function rlFileChosen(input) {
    const file = input.files[0];
    document.getElementById('rl-file-name').textContent = file ? file.name : 'No file chosen';
}

function rlOnSubmit() {
    const fileInput = document.getElementById('rl-file-input');
    if (!fileInput.files || !fileInput.files.length) {
        alert('Please choose a file first.');
        return false;
    }
    const btn = document.getElementById('rl-upload-btn');
    const status = document.getElementById('rl-upload-status');
    btn.disabled = true;
    btn.textContent = 'Uploading…';
    status.textContent = 'Uploading your document…';
    return true;
}

@if (TempData["Success"] != null || TempData["Error"] != null) {
    @:document.getElementById('upload-panel')?.classList.remove('rl-hidden');
}
</script>
}
