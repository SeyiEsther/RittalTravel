@model RittalTravel.Models.Trip
@{
    ViewData["Title"] = "Log Trip";
    Layout = null;
    var googleMapsKey = ViewBag.GoogleMapsApiKey as string ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Log Trip — Rittal Travel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/logtrip.css" asp-append-version="true" />
</head>
<body class="lt-body">

<nav class="rt-nav">
    <div class="rt-nav-inner">
        <a class="rt-wordmark" asp-controller="Dashboard" asp-action="Index">
            <span class="rt-word-rittal">Rittal</span><span class="rt-word-travel">Travel</span>
        </a>
        <ul class="rt-nav-links">
            <li><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
            <li><a asp-controller="Trip" asp-action="Index">Trip Log</a></li>
            <li><a asp-controller="Trip" asp-action="LogTrip" class="active">Log Trip</a></li>
            <li><a asp-controller="Report" asp-action="Generate">Download Report</a></li>
        </ul>
        <div class="rt-nav-user">
            <span class="rt-user-name">@User.Identity?.Name</span>
            <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="rt-logout-btn">Logout</button>
            </form>
        </div>
    </div>
</nav>

<div class="lt-wrap">
    <div class="lt-header">
        <h1>Log Business Trip</h1>
        <p>All fields calculated server-side using DEFRA 2025 factors</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="rt-alert rt-alert-error">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form id="logTripForm" asp-action="LogTrip" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" id="waypointsInput" name="waypointsJson" value="" />

        <!-- ── Traveller Details ──────────────────────────────────────── -->
        <div class="lt-section">
            <h2 class="lt-section-title">Traveller Details</h2>
            <div class="lt-grid-2">
                <div class="lt-field">
                    <label asp-for="TravellerName">Traveller Full Name <span class="lt-req">*</span></label>
                    <input asp-for="TravellerName" class="lt-input" placeholder="e.g. Ali Hassan" required />
                    <span asp-validation-for="TravellerName" class="lt-val-error"></span>
                </div>
                <div class="lt-field">
                    <label asp-for="Purpose">Purpose of Trip</label>
                    <input asp-for="Purpose" class="lt-input" placeholder="e.g. Client meeting, Conference" />
                </div>
            </div>
        </div>

        <!-- ── Journey ───────────────────────────────────────────────── -->
        <div class="lt-section">
            <h2 class="lt-section-title">Journey</h2>

            <div class="lt-field">
                <label asp-for="Origin">Origin <span class="lt-req">*</span></label>
                <input asp-for="Origin" id="originInput" class="lt-input" placeholder="e.g. London, UK" required autocomplete="off" />
            </div>

            <!-- Waypoints -->
            <div id="waypointsContainer"></div>
            <button type="button" id="addWaypointBtn" class="lt-btn-ghost">+ Add Stopover</button>

            <div class="lt-field lt-mt">
                <label asp-for="Destination">Destination <span class="lt-req">*</span></label>
                <input asp-for="Destination" id="destinationInput" class="lt-input" placeholder="e.g. Frankfurt, Germany" required autocomplete="off" />
            </div>
        </div>

        <!-- ── Trip Details ───────────────────────────────────────────── -->
        <div class="lt-section">
            <h2 class="lt-section-title">Trip Details</h2>
            <div class="lt-grid-2">
                <div class="lt-field">
                    <label asp-for="TransportMode">Transport Mode <span class="lt-req">*</span></label>
                    <select asp-for="TransportMode" class="lt-select" required>
                        <option value="">-- Select Mode --</option>
                        <optgroup label="Flights">
                            <option value="Flight-Domestic">Flight - Domestic</option>
                            <option value="Flight-ShortHaul">Flight - Short Haul</option>
                            <option value="Flight-LongHaul">Flight - Long Haul</option>
                        </optgroup>
                        <optgroup label="Rail">
                            <option value="Train-National">Train - National</option>
                            <option value="Train-International">Train - International</option>
                            <option value="Train-Underground">Train - Underground/Metro</option>
                        </optgroup>
                        <optgroup label="Car">
                            <option value="Car-Diesel">Car - Diesel</option>
                            <option value="Car-Petrol">Car - Petrol</option>
                            <option value="Car-Electric">Car - Electric</option>
                            <option value="Car-Hybrid">Car - Hybrid</option>
                        </optgroup>
                        <optgroup label="Bus / Coach">
                            <option value="Bus-Local">Bus - Local</option>
                            <option value="Coach-National">Coach - National</option>
                        </optgroup>
                        <optgroup label="Taxi">
                            <option value="Taxi-Regular">Taxi - Regular</option>
                            <option value="Taxi-Electric">Taxi - Electric</option>
                        </optgroup>
                        <optgroup label="Ferry">
                            <option value="Ferry-Foot">Ferry - Foot Passenger</option>
                        </optgroup>
                    </select>
                </div>

                <div class="lt-field">
                    <label asp-for="TravelClass">Travel Class</label>
                    <select asp-for="TravelClass" class="lt-select">
                        <option value="Economy">Economy</option>
                        <option value="Business">Business</option>
                        <option value="First">First</option>
                        <option value="Standard">Standard</option>
                        <option value="Premium">Premium</option>
                    </select>
                </div>

                <div class="lt-field">
                    <label asp-for="TripDate">Trip Date <span class="lt-req">*</span></label>
                    <input asp-for="TripDate" type="date" class="lt-input" required />
                </div>

                <div class="lt-field">
                    <label asp-for="Passengers">Passengers <span class="lt-req">*</span></label>
                    <input asp-for="Passengers" type="number" min="1" max="500" class="lt-input" required />
                </div>
            </div>

            <!-- Return trip -->
            <div class="lt-field lt-mt">
                <label class="lt-checkbox-label">
                    <input type="checkbox" id="returnTripCheck" name="returnTrip" value="true" class="lt-checkbox" />
                    <span>Return trip</span>
                </label>
            </div>

            <div id="returnSection" style="display:none">
                <div class="lt-field">
                    <label class="lt-checkbox-label">
                        <input type="checkbox" id="differentReturnCheck" name="differentReturn" value="true" class="lt-checkbox" />
                        <span>Different return route</span>
                    </label>
                </div>
                <div id="returnRouteFields" style="display:none">
                    <div class="lt-grid-2">
                        <div class="lt-field">
                            <label>Return Origin</label>
                            <input type="text" name="returnOrigin" id="returnOriginInput" class="lt-input" placeholder="Return origin" autocomplete="off" />
                        </div>
                        <div class="lt-field">
                            <label>Return Destination</label>
                            <input type="text" name="returnDestination" id="returnDestInput" class="lt-input" placeholder="Return destination" autocomplete="off" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="lt-field lt-mt">
                <label asp-for="Notes">Notes</label>
                <textarea asp-for="Notes" class="lt-textarea" rows="2" placeholder="Optional notes"></textarea>
            </div>
        </div>

        <!-- ── Live Estimate Panel ────────────────────────────────────── -->
        <div class="lt-section lt-preview" id="livePreview">
            <h2 class="lt-section-title">Live Estimate</h2>
            <p class="lt-preview-note">Client-side Haversine estimate — final calculation uses server-side Google Maps API</p>
            <div class="lt-preview-grid">
                <div class="lt-preview-item">
                    <span class="lt-preview-label">Est. Distance</span>
                    <span class="lt-preview-value" id="previewDist">—</span>
                </div>
                <div class="lt-preview-item">
                    <span class="lt-preview-label">DEFRA Factor</span>
                    <span class="lt-preview-value" id="previewFactor">—</span>
                </div>
                <div class="lt-preview-item">
                    <span class="lt-preview-label">Est. kgCO2e</span>
                    <span class="lt-preview-value" id="previewKg">—</span>
                </div>
                <div class="lt-preview-item">
                    <span class="lt-preview-label">Est. tCO2e</span>
                    <span class="lt-preview-value" id="previewT">—</span>
                </div>
            </div>
        </div>

        <!-- ── Map ────────────────────────────────────────────────────── -->
        @if (!string.IsNullOrWhiteSpace(googleMapsKey))
        {
            <div class="lt-section">
                <h2 class="lt-section-title">Route Map</h2>
                <div id="mapContainer" class="lt-map"></div>
            </div>
        }

        <div class="lt-actions">
            <a asp-controller="Trip" asp-action="Index" class="lt-btn-cancel">Cancel</a>
            <button type="submit" id="submitBtn" class="lt-btn-submit">
                <span id="submitText">Calculate and Save Trip</span>
                <span id="submitSpinner" style="display:none">Calculating...</span>
            </button>
        </div>
    </form>
</div>

<script>
// ── DEFRA 2025 factors (client-side for live estimate only) ──────────────
var DEFRA_FACTORS = {
    "Flight-Domestic":0.24468,"Flight-ShortHaul":0.15553,"Flight-LongHaul":0.19085,
    "Train-National":0.03549,"Train-International":0.00415,"Train-Underground":0.02800,
    "Car-Diesel":0.16844,"Car-Petrol":0.17380,"Car-Electric":0.04714,"Car-Hybrid":0.11565,
    "Bus-Local":0.10213,"Coach-National":0.02722,
    "Taxi-Regular":0.14938,"Taxi-Electric":0.04714,
    "Ferry-Foot":0.01867
};
var CLASS_MULT = {"Economy":1.0,"Business":2.0,"First":2.4,"Standard":1.0,"Premium":1.6};

// Geocode cache for live estimate
var geocodeCache = {};

function toRad(d){return d*Math.PI/180;}
function haversine(la1,lo1,la2,lo2){
    var R=6371,dLa=toRad(la2-la1),dLo=toRad(lo2-lo1);
    var a=Math.sin(dLa/2)*Math.sin(dLa/2)+Math.cos(toRad(la1))*Math.cos(toRad(la2))*Math.sin(dLo/2)*Math.sin(dLo/2);
    return R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));
}

// Approximate coordinates for common cities (live preview fallback)
var CITY_COORDS = {
    "london":[51.5074,-0.1278],"manchester":[53.4808,-2.2426],"birmingham":[52.4862,-1.8904],
    "edinburgh":[55.9533,-3.1883],"bristol":[51.4545,-2.5879],"leeds":[53.8008,-1.5491],
    "sheffield":[53.3811,-1.4701],"frankfurt":[50.1109,8.6821],"brussels":[50.8503,4.3517],
    "new york":[40.7128,-74.006],"paris":[48.8566,2.3522],"amsterdam":[52.3676,4.9041],
    "berlin":[52.5200,13.4050],"dublin":[53.3498,-6.2603],"glasgow":[55.8642,-4.2518],
    "liverpool":[53.4084,-2.9916],"nottingham":[52.9548,-1.1581],"cardiff":[51.4816,-3.1791],
    "york":[53.9591,-1.0815],"hellaby":[53.4167,-1.2833]
};

function guessCoords(name){
    if(!name)return null;
    var n=name.toLowerCase();
    for(var k in CITY_COORDS){if(n.indexOf(k)>=0)return CITY_COORDS[k];}
    return null;
}

function updatePreview(){
    var orig=document.getElementById('originInput').value;
    var dest=document.getElementById('destinationInput').value;
    var mode=document.querySelector('[name="TransportMode"]').value;
    var cls=document.querySelector('[name="TravelClass"]').value||'Economy';
    var pax=parseInt(document.querySelector('[name="Passengers"]').value)||1;

    var c1=guessCoords(orig), c2=guessCoords(dest);
    if(!c1||!c2||!mode){
        ['previewDist','previewFactor','previewKg','previewT'].forEach(function(id){document.getElementById(id).textContent='—';});
        return;
    }

    var dist=haversine(c1[0],c1[1],c2[0],c2[1]);
    var baseFactor=DEFRA_FACTORS[mode]||0;
    var mult=(mode.indexOf('Flight')>=0)?(CLASS_MULT[cls]||1.0):1.0;
    var factor=baseFactor*mult;
    var kg=dist*factor*pax;

    document.getElementById('previewDist').textContent=dist.toFixed(1)+' km';
    document.getElementById('previewFactor').textContent=factor.toFixed(5);
    document.getElementById('previewKg').textContent=kg.toFixed(3);
    document.getElementById('previewT').textContent=(kg/1000).toFixed(6);
}

// Wire up live preview inputs
['originInput','destinationInput'].forEach(function(id){
    document.getElementById(id).addEventListener('input', updatePreview);
});
document.querySelector('[name="TransportMode"]').addEventListener('change', updatePreview);
document.querySelector('[name="TravelClass"]').addEventListener('change', updatePreview);
document.querySelector('[name="Passengers"]').addEventListener('input', updatePreview);

// Return trip toggles
document.getElementById('returnTripCheck').addEventListener('change', function(){
    document.getElementById('returnSection').style.display=this.checked?'block':'none';
});
document.getElementById('differentReturnCheck').addEventListener('change', function(){
    document.getElementById('returnRouteFields').style.display=this.checked?'block':'none';
});

// Waypoints
var waypointCount=0;
document.getElementById('addWaypointBtn').addEventListener('click', function(){
    waypointCount++;
    var idx=waypointCount;
    var div=document.createElement('div');
    div.className='lt-waypoint';
    div.id='wp-'+idx;
    div.innerHTML='<div class="lt-waypoint-inner">'
        +'<div class="lt-field lt-field--grow"><label>Stopover '+idx+'</label>'
        +'<input type="text" class="lt-input wp-location" placeholder="City / location" data-idx="'+idx+'" autocomplete="off"/></div>'
        +'<div class="lt-field"><label>Mode</label>'
        +'<select class="lt-select wp-mode" data-idx="'+idx+'">'
        +'<option value="Flight-ShortHaul">Flight - Short Haul</option>'
        +'<option value="Flight-Domestic">Flight - Domestic</option>'
        +'<option value="Flight-LongHaul">Flight - Long Haul</option>'
        +'<option value="Train-National" selected>Train - National</option>'
        +'<option value="Train-International">Train - International</option>'
        +'<option value="Car-Diesel">Car - Diesel</option>'
        +'<option value="Car-Petrol">Car - Petrol</option>'
        +'<option value="Car-Electric">Car - Electric</option>'
        +'<option value="Car-Hybrid">Car - Hybrid</option>'
        +'<option value="Bus-Local">Bus - Local</option>'
        +'<option value="Coach-National">Coach - National</option>'
        +'<option value="Taxi-Regular">Taxi - Regular</option>'
        +'<option value="Ferry-Foot">Ferry - Foot</option>'
        +'</select></div>'
        +'<div class="lt-field"><label>Class</label>'
        +'<select class="lt-select wp-class" data-idx="'+idx+'">'
        +'<option value="Economy">Economy</option>'
        +'<option value="Business">Business</option>'
        +'<option value="First">First</option>'
        +'<option value="Standard">Standard</option>'
        +'</select></div>'
        +'<button type="button" class="lt-btn-remove" onclick="removeWaypoint('+idx+')">Remove</button>'
        +'</div>';
    document.getElementById('waypointsContainer').appendChild(div);
});

function removeWaypoint(idx){
    var el=document.getElementById('wp-'+idx);
    if(el) el.remove();
}

// Build waypoints JSON on submit
document.getElementById('logTripForm').addEventListener('submit', function(e){
    var wps=[];
    document.querySelectorAll('.lt-waypoint').forEach(function(div){
        var loc=div.querySelector('.wp-location').value;
        var mode=div.querySelector('.wp-mode').value;
        var cls=div.querySelector('.wp-class').value;
        wps.push({Location:loc, Mode:mode, TravelClass:cls});
    });
    document.getElementById('waypointsInput').value=JSON.stringify(wps);

    var btn=document.getElementById('submitBtn');
    btn.disabled=true;
    document.getElementById('submitText').style.display='none';
    document.getElementById('submitSpinner').style.display='inline';
});
</script>

@if (!string.IsNullOrWhiteSpace(googleMapsKey))
{
    <script>
    // Google Maps route visualisation
    var map, directionsService, directionsRendererOut, directionsRendererReturn;

    function initMap(){
        map=new google.maps.Map(document.getElementById('mapContainer'),{
            center:{lat:52.5,lng:-1.9},zoom:5,
            mapTypeId:'roadmap',
            styles:[{elementType:'geometry',stylers:[{color:'#1d2c4d'}]},{elementType:'labels.text.fill',stylers:[{color:'#8ec3b9'}]}]
        });
        directionsService=new google.maps.DirectionsService();
        directionsRendererOut=new google.maps.DirectionsRenderer({map:map,polylineOptions:{strokeColor:'#3FB950',strokeWeight:3}});
        directionsRendererReturn=new google.maps.DirectionsRenderer({map:map,polylineOptions:{strokeColor:'#8B5CF6',strokeWeight:3},suppressMarkers:true});
    }

    function updateMap(){
        var orig=document.getElementById('originInput').value;
        var dest=document.getElementById('destinationInput').value;
        if(!orig||!dest||!directionsService)return;
        directionsService.route({origin:orig,destination:dest,travelMode:'DRIVING'},function(r,s){
            if(s==='OK')directionsRendererOut.setDirections(r);
        });
    }

    document.getElementById('originInput').addEventListener('change',updateMap);
    document.getElementById('destinationInput').addEventListener('change',updateMap);
    </script>
    <script src="https://maps.googleapis.com/maps/api/js?key=@googleMapsKey&callback=initMap" async defer></script>
}
</body>
</html>
