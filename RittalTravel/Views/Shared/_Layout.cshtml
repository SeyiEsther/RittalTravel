@inject Microsoft.Extensions.Configuration.IConfiguration _layoutCfg
@{
    var _defraYear       = _layoutCfg["RittalTravel:DefraFactorYear"] ?? "DEFRA 2025";
    var _defraReviewStr  = _layoutCfg["RittalTravel:DefraReviewDate"] ?? "";
    var _showDefraBanner = DateTime.TryParse(_defraReviewStr, out var _reviewDate) && DateTime.Now >= _reviewDate;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Rittal Travel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="rt-nav">
    <div class="rt-nav-inner">
        <a class="rt-wordmark" asp-controller="Dashboard" asp-action="Index">
            <span class="rt-word-rittal">Rittal</span><span class="rt-word-travel">Travel</span>
        </a>
        <ul class="rt-nav-links">
            <li><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
            <li><a asp-controller="Trip" asp-action="Index">Trip Log</a></li>
            <li><a asp-controller="Trip" asp-action="LogTrip">Log Trip</a></li>
            <li><a asp-controller="Receipt" asp-action="Index">Receipts &amp; Invoices</a></li>
            <li><a asp-controller="Report" asp-action="Generate">Download Report</a></li>
        </ul>
    </div>
</nav>
@if (_showDefraBanner) {
<div id="defra-banner" class="rt-defra-banner" style="display:none">
    <span>
        <strong>&#9888; @_defraYear factors may be out of date.</strong>
        DEFRA publishes updated GHG conversion factors each June/July.
        Update <code>DefraCalculator.cs</code> and <code>appsettings.json</code>
        then set <code>DefraReviewDate</code> to next year's review date.
    </span>
    <button class="rt-defra-banner-close"
            onclick="this.closest('#defra-banner').style.display='none';sessionStorage.setItem('defraBannerDismissed','1')">
        &times; Dismiss
    </button>
</div>
<script>if(!sessionStorage.getItem('defraBannerDismissed'))document.getElementById('defra-banner').style.display='';</script>
}
<main class="rt-main">
    @RenderBody()
</main>
@RenderSection("Scripts", required: false)
</body>
</html>
