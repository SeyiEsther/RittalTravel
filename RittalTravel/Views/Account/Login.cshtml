@{
    Layout = null;
    ViewData["Title"] = "Sign In";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rittal Travel — Sign In</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="rt-login-body">
    <div class="rt-login-orb rt-login-orb-1"></div>
    <div class="rt-login-orb rt-login-orb-2"></div>
    <div class="rt-login-orb rt-login-orb-3"></div>
    <div class="rt-login-wrap">
        <div class="rt-login-card">
            <div class="rt-login-header">
                <div class="rt-login-wordmark">
                    <span class="rt-word-rittal">Rittal</span><span class="rt-word-travel">Travel</span>
                </div>
                <p class="rt-login-subtitle">Business Travel Carbon Reporting</p>
            </div>
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="rt-alert rt-alert-error">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    { <div>@error.ErrorMessage</div> }
                </div>
            }
            <form method="post" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                @Html.AntiForgeryToken()
                <div class="rt-field">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" class="rt-input" placeholder="user@rittal.co.uk" required autofocus />
                </div>
                <div class="rt-field">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" class="rt-input" placeholder="Password" required />
                </div>
                <button type="submit" class="rt-btn rt-btn-red rt-btn-full">Sign In</button>
            </form>
            <div class="rt-login-footer">
                DEFRA 2025 &middot; GHG Protocol &middot; Rittal UK Internal System
            </div>
        </div>
    </div>
</body>
</html>
